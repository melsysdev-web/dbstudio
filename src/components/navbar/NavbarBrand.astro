---
interface Props {
  studio?: string;
  architect?: string;
  specialty?: string;
}

const {
  studio = "DBStudio",
  architect = "Daniela Benavides",
  specialty = "Arquitectura y Diseño",
} = Astro.props;
---

<a
  href="#inicio"
  class="navbar-brand group flex min-w-0 items-center gap-2 sm:gap-3"
  aria-label={`${studio} — ${architect}`}
>
  <!-- Logo arquitectónico SVG -->
  <svg
    viewBox="0 0 220 70"
    fill="none"
    xmlns="http://www.w3.org/2000/svg"
    class="navbar-brand__logo shrink-0 text-secondary transition-transform duration-300 group-hover:scale-[1.03]"
    aria-hidden="true"
  >
    <path d="M8 52H212" stroke="currentColor" stroke-width="1.4" />
    <path d="M28 34L100 12" stroke="currentColor" stroke-width="1.4" />
    <path d="M91 16L151 36" stroke="currentColor" stroke-width="1.4" />
    <path d="M28 34H112" stroke="currentColor" stroke-width="1.4" />
    <path d="M43 34V52" stroke="currentColor" stroke-width="1.4" />
    <path d="M100 26V52" stroke="currentColor" stroke-width="1.4" />
    <path d="M76 52V37H88V52" stroke="currentColor" stroke-width="1.4" />
    <path d="M141 33V52" stroke="currentColor" stroke-width="1.4" />
  </svg>

  <!-- Nombre del estudio y arquitecta -->
  <span class="navbar-brand__text flex min-w-0 flex-col gap-0.5">
    <span class="truncate text-sm font-semibold leading-tight tracking-wide sm:text-base">
      {studio}
    </span>

    <span class="truncate text-[11px] leading-tight text-foreground/80 sm:text-xs">
      {architect}
    </span>

    <span class="navbar-brand__specialty truncate text-[9px] font-medium uppercase leading-tight tracking-[0.1em] text-foreground/60 sm:text-[10px] sm:tracking-[0.12em]">
      {specialty}
    </span>
  </span>
</a>