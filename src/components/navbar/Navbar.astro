---
import { ArrowUpRight } from "@lucide/astro";
import NavbarBrand from "./NavbarBrand.astro";
import NavbarLinks from "./NavbarLinks.astro";
import NavbarMobile from "./NavbarMobile.astro";
import ThemeToggle from "./ThemeToggle.astro";
import LanguageToggle from "./LanguageToggle.astro";
---

<header class="fixed inset-x-0 top-0 z-50 px-4 pt-4 sm:px-6">
  <div class="bg-glass-panel mx-auto flex max-w-7xl items-center justify-between gap-3 rounded-2xl border border-border/70 px-4 py-3 shadow-glass sm:gap-5 sm:px-7">
    <NavbarBrand />

    <div class="hidden lg:block">
      <NavbarLinks />
    </div>

    <div class="hidden shrink-0 items-center gap-3 lg:flex">
      <LanguageToggle />
      <ThemeToggle />

      <a
        href="#contacto"
        class="inline-flex items-center gap-2 rounded-full bg-primary px-5 py-3 text-sm font-medium text-primary-foreground transition-all duration-300 hover:bg-secondary"
      >
        Hablemos
        <ArrowUpRight size={16} strokeWidth={1.8} />
      </a>
    </div>

    <div class="flex shrink-0 items-center gap-1 lg:hidden">
      <LanguageToggle />
      <ThemeToggle />
      <NavbarMobile />
    </div>
  </div>
</header>