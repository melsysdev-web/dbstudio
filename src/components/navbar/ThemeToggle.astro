---
---

<label class="theme-switch" aria-label="Cambiar entre tema claro y oscuro">
  <input
    class="theme-switch__input"
    type="checkbox"
    data-theme-switch
    aria-label="Activar modo oscuro"
  />

  <span class="theme-switch__track">
    <span class="theme-switch__stars" aria-hidden="true">
      <span class="theme-switch__star theme-switch__star--1">✦</span>
      <span class="theme-switch__star theme-switch__star--2">✦</span>
      <span class="theme-switch__star theme-switch__star--3">✦</span>
      <span class="theme-switch__star theme-switch__star--4">✦</span>
    </span>

    <span class="theme-switch__clouds" aria-hidden="true">
      <span class="theme-switch__cloud theme-switch__cloud--1"></span>
      <span class="theme-switch__cloud theme-switch__cloud--2"></span>
    </span>

    <span class="theme-switch__thumb" aria-hidden="true">
      <svg class="theme-switch__moon" viewBox="0 0 24 24">
        <circle cx="8" cy="6" r="3" />
        <circle cx="5" cy="13" r="2" />
        <circle cx="14" cy="17" r="1.5" />
      </svg>
      <span class="theme-switch__sun"></span>
    </span>
  </span>
</label>

<script>
  const switches = document.querySelectorAll<HTMLInputElement>(
    "[data-theme-switch]",
  );

  const root = document.documentElement;

  function syncThemeSwitches() {
    const isDark = root.classList.contains("dark");

    switches.forEach((toggle) => {
      toggle.checked = isDark;
      toggle.setAttribute("aria-label", isDark
        ? "Desactivar modo oscuro"
        : "Activar modo oscuro");
    });
  }

  switches.forEach((toggle) => {
    toggle.addEventListener("change", () => {
      const isDark = toggle.checked;

      root.classList.toggle("dark", isDark);
      localStorage.setItem("theme", isDark ? "dark" : "light");

      syncThemeSwitches();
    });
  });

  syncThemeSwitches();

  document.addEventListener("astro:after-swap", syncThemeSwitches);
</script>