---
import { Mail, MessageCircle, Linkedin, ArrowUpRight } from "@lucide/astro";

interface Props {
  icon: "mail" | "whatsapp" | "linkedin";
  title: string;
  description: string;
  action: string;
  href: string;
  external: boolean;
}

const { icon, title, description, action, href, external } =
  Astro.props;
---

<a
  href={href}
  target={external ? "_blank" : undefined}
  rel={external ? "noopener noreferrer" : undefined}
  class="group flex min-h-64 flex-col justify-between border border-border/70 bg-surface-container-low p-7 transition-all duration-300 hover:-translate-y-1 hover:border-secondary/60 sm:p-9"
>
  <div class="flex items-center justify-between">
    {icon === "mail" && (
      <Mail size={25} strokeWidth={1.5} class="text-secondary" />
    )}

    {icon === "whatsapp" && (
      <MessageCircle size={25} strokeWidth={1.5} class="text-secondary" />
    )}

    {icon === "linkedin" && (
      <Linkedin size={25} strokeWidth={1.5} class="text-secondary" />
    )}

    <ArrowUpRight
      size={20}
      class="text-on-surface-variant transition-transform duration-300 group-hover:-translate-y-1 group-hover:translate-x-1 group-hover:text-secondary"
    />
  </div>

  <div class="mt-12">
    <h3 class="font-headline text-2xl">{title}</h3>

    <p class="mt-3 text-sm leading-6 text-on-surface-variant">
      {description}
    </p>

    <p class="mt-5 text-xs font-semibold uppercase tracking-[0.18em] text-secondary">
      {action}
    </p>
  </div>
</a>
