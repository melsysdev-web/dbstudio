
---
import { ArrowUpRight, GraduationCap } from "@lucide/astro";

const education = [
  {
    period: "AÑO DE INICIO — AÑO DE FINALIZACIÓN",
    degree: "Nombre del título o programa académico",
    institution: "Nombre de la institución educativa",
    description:
      "Describe brevemente los conocimientos adquiridos, la especialidad o los principales logros académicos.",
    status: "Completado / En curso",
  },
  {
    period: "AÑO DE INICIO — AÑO DE FINALIZACIÓN",
    degree: "Curso, certificación o formación adicional",
    institution: "Nombre de la institución",
    description:
      "Añade aquí una formación complementaria relevante para tu perfil profesional.",
    status: "Completado",
  },
];
---

<section
  id="educacion"
  aria-labelledby="education-title"
  class="bg-background px-6 py-24 text-foreground sm:px-10 sm:py-32 lg:px-16"
>
  <div class="mx-auto max-w-7xl">
    <!-- Encabezado -->
    <div
      class="mb-14 flex flex-col gap-6 md:mb-20 md:flex-row md:items-end md:justify-between"
    >
      <div class="max-w-2xl">
        <span
          class="mb-5 inline-flex items-center gap-2 text-xs font-semibold uppercase tracking-[0.2em] text-secondary"
        >
          <GraduationCap size={17} strokeWidth={1.7} />
          Formación académica
        </span>

        <h2
          id="education-title"
          class="font-headline text-5xl font-medium leading-[1.05] tracking-tight sm:text-6xl lg:text-7xl"
        >
          Educación<span class="text-secondary">.</span>
          <br />
          <span class="italic">Aprender para crecer.</span>
        </h2>
      </div>

      <p
        class="max-w-md text-base leading-7 text-on-surface-variant"
      >
        Un recorrido por mi formación académica y las experiencias
        de aprendizaje que contribuyen a mi desarrollo personal
        y profesional.
      </p>
    </div>

    <!-- Lista de formación -->
    <div class="border-t border-border">
      {
        education.map((item, index) => (
          <article class="group grid gap-5 border-b border-border py-8 md:grid-cols-[180px_1fr_auto] md:gap-10 md:py-10">
            <div class="flex items-start gap-3">
              <span class="font-headline text-2xl italic text-secondary">
                {String(index + 1).padStart(2, "0")}
              </span>

              <span class="pt-2 text-xs leading-5 text-on-surface-variant">
                {item.period}
              </span>
            </div>

            <div>
              <h3 class="font-headline text-2xl font-medium leading-snug transition-colors duration-300 group-hover:text-secondary sm:text-3xl">
                {item.degree}
              </h3>

              <p class="mt-2 text-sm font-medium text-on-surface-variant">
                {item.institution}
              </p>

              <p class="mt-4 max-w-2xl text-sm leading-7 text-on-surface-variant">
                {item.description}
              </p>

              <span class="mt-5 inline-flex rounded-full border border-border px-3 py-1 text-xs text-on-surface-variant">
                {item.status}
              </span>
            </div>

            <div class="hidden items-start pt-1 md:flex">
              <ArrowUpRight
                size={22}
                strokeWidth={1.4}
                className="text-on-surface-variant transition-transform duration-300 group-hover:-translate-y-1 group-hover:translate-x-1 group-hover:text-secondary"
              />
            </div>
          </article>
        ))
      }
    </div>

    <!-- Cierre -->
    <div class="mt-10 flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
      <p class="text-sm text-on-surface-variant">
        La formación continua es parte de mi camino profesional.
      </p>

      <a
        href="#contacto"
        class="inline-flex w-fit items-center gap-2 text-sm font-semibold transition-colors hover:text-secondary"
      >
        Conversemos
        <ArrowUpRight size={17} strokeWidth={1.7} />
      </a>
    </div>
  </div>
</section>
