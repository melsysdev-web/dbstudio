
---
import { MoveUpRight } from "@lucide/astro";
import type { Project } from "./projects.data";

interface Props {
  project: Project;
}

const { project } = Astro.props;
---

<article class:list={["group", project.layout]}>
  <a
    href="#contacto"
    class="block"
    aria-label={`Conocer más sobre ${project.title}`}
  >
    <div
      class:list={[
        "relative isolate overflow-hidden rounded-xl bg-surface-variant",
        project.imageHeight,
      ]}
    >
      <img
        src={project.image}
        alt={project.alt}
        loading="lazy"
        class="size-full object-cover transition-transform duration-700 ease-out group-hover:scale-[1.04]"
      />

      <div class="absolute inset-0 bg-foreground/0 transition-colors duration-500 group-hover:bg-foreground/10"></div>

      <span class="absolute left-4 top-4 flex size-10 items-center justify-center rounded-full border border-white/50 bg-background/80 text-sm text-foreground backdrop-blur-sm sm:left-5 sm:top-5">
        {project.number}
      </span>

      <span class="absolute bottom-4 right-4 flex size-11 translate-y-2 items-center justify-center rounded-full bg-background text-foreground opacity-0 transition-all duration-300 group-hover:translate-y-0 group-hover:opacity-100 sm:bottom-5 sm:right-5">
        <MoveUpRight size={20} strokeWidth={1.6} />
      </span>
    </div>
  </a>

  <div class="flex items-start justify-between gap-4 pt-5">
    <div>
      <p class="mb-2 text-xs font-medium uppercase tracking-[0.16em] text-secondary">
        {project.category}
      </p>

      <h3 class="font-headline text-2xl font-medium tracking-tight transition-colors duration-300 group-hover:text-secondary sm:text-3xl">
        {project.title}
      </h3>
    </div>

    <span class="pt-1 text-xs text-on-surface-variant">
      {project.year}
    </span>
  </div>
</article>
