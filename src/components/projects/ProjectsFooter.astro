
---
import { ArrowUpRight } from "@lucide/astro";
---

<div class="mt-16 border-t border-border pt-8 sm:mt-24 sm:flex sm:items-center sm:justify-between">
  <p class="max-w-md text-sm leading-6 text-on-surface-variant">
    Cada proyecto es una oportunidad para explorar, aprender y crear
    algo significativo.
  </p>

  <a
    href="#contacto"
    class="mt-5 inline-flex items-center gap-3 text-sm font-semibold transition-colors hover:text-secondary sm:mt-0"
  >
    ¿Creamos algo juntos?
    <ArrowUpRight size={18} strokeWidth={1.7} />
  </a>
</div>
